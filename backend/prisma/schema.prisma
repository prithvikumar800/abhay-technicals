// ============================================================================
// ABHAY TECHNICALS — PRISMA DATABASE SCHEMA
// Engine: MySQL 8.0
// Platform: Node.js + Express.js + TypeScript
// Target Hosting: Hostinger Business Hosting (Isolated Database)
// Version: 1.0.0 (Phase 4 Database Architecture)
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// ENUMS
// ============================================================================

enum UserRole {
  CUSTOMER
  WHOLESALER
  ADMIN
  STAFF
}

enum UserStatus {
  ACTIVE
  BLOCKED
  PENDING_VERIFICATION
}

enum DevicePlatform {
  ANDROID
  IOS
  WEB
}

enum OrderStatus {
  RECEIVED
  PROCESSING
  MANIFESTED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentGateway {
  RAZORPAY
  CASHFREE
  MANUAL_COD
}

enum ShipmentStatus {
  PENDING
  MANIFESTED
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  RTO
  FAILED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

// ============================================================================
// USERS & AUTHENTICATION
// ============================================================================

model User {
  id              String      @id @default(uuid()) @db.VarChar(36)
  phone           String      @unique @db.VarChar(15)
  name            String?     @db.VarChar(100)
  businessName    String?     @db.VarChar(150)
  gstin           String?     @db.VarChar(15)
  role            UserRole    @default(CUSTOMER)
  status          UserStatus  @default(ACTIVE)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  deletedAt       DateTime?

  // Relationships
  addresses       UserAddress[]
  devices         UserDevice[]
  refreshTokens   RefreshToken[]
  orders          Order[]
  cart            Cart?
  reviews         Review[]
  blogPosts       BlogPost[]
  auditLogs       AuditLog[]
  statusChanges   OrderStatusHistory[]

  @@index([phone])
  @@index([role])
  @@index([status])
  @@map("users")
}

model OtpVerification {
  id          String   @id @default(uuid()) @db.VarChar(36)
  phone       String   @db.VarChar(15)
  hashedOtp   String   @db.VarChar(255)
  expiresAt   DateTime
  attempts    Int      @default(0)
  verified    Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([phone, verified, expiresAt])
  @@map("otp_verifications")
}

model RefreshToken {
  id          String   @id @default(uuid()) @db.VarChar(36)
  userId      String   @db.VarChar(36)
  tokenHash   String   @unique @db.VarChar(255)
  revoked     Boolean  @default(false)
  expiresAt   DateTime
  userAgent   String?  @db.VarChar(255)
  ipAddress   String?  @db.VarChar(45)
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

model UserAddress {
  id                String    @id @default(uuid()) @db.VarChar(36)
  userId            String    @db.VarChar(36)
  name              String    @db.VarChar(100)
  phone             String    @db.VarChar(15)
  addressLine1      String    @db.VarChar(255)
  addressLine2      String?   @db.VarChar(255)
  landmark          String?   @db.VarChar(150)
  city              String    @db.VarChar(80)
  state             String    @db.VarChar(80)
  pincode           String    @db.VarChar(10)
  isDefaultShipping Boolean   @default(false)
  isDefaultBilling  Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([pincode])
  @@map("user_addresses")
}

model UserDevice {
  id          String         @id @default(uuid()) @db.VarChar(36)
  userId      String?        @db.VarChar(36)
  fcmToken    String         @unique @db.VarChar(255)
  platform    DevicePlatform @default(ANDROID)
  deviceModel String?        @db.VarChar(100)
  appVersion  String?        @db.VarChar(30)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  user        User?          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([platform])
  @@map("user_devices")
}

// ============================================================================
// CATALOGUE & TAXONOMY
// ============================================================================

model Brand {
  id              Int           @id @default(autoincrement())
  name            String        @unique @db.VarChar(100)
  slug            String        @unique @db.VarChar(120)
  logoUrl         String?       @db.VarChar(255)
  isActive        Boolean       @default(true)
  metaTitle       String?       @db.VarChar(255)
  metaDescription String?       @db.VarChar(500)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Relationships
  models          DeviceModel[]
  products        Product[]

  @@index([slug])
  @@index([isActive])
  @@map("brands")
}

model DeviceModel {
  id              Int                    @id @default(autoincrement())
  brandId         Int
  name            String                 @db.VarChar(120)
  slug            String                 @unique @db.VarChar(150)
  releaseYear     Int?
  imageUrl        String?                @db.VarChar(255)
  isActive        Boolean                @default(true)
  metaTitle       String?                @db.VarChar(255)
  metaDescription String?                @db.VarChar(500)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  // Relationships
  brand           Brand                  @relation(fields: [brandId], references: [id], onDelete: Restrict)
  products        Product[]
  compatibilities ProductCompatibility[]

  @@index([brandId])
  @@index([slug])
  @@index([isActive])
  @@map("device_models")
}

model Category {
  id              Int        @id @default(autoincrement())
  parentId        Int?
  name            String     @db.VarChar(100)
  slug            String     @unique @db.VarChar(120)
  imageUrl        String?    @db.VarChar(255)
  sortOrder       Int        @default(0)
  isActive        Boolean    @default(true)
  metaTitle       String?    @db.VarChar(255)
  metaDescription String?    @db.VarChar(500)
  sourceId        Int?       @unique // Original WooCommerce Category ID
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  // Relationships
  parent          Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children        Category[] @relation("CategoryHierarchy")
  products        Product[]

  @@index([parentId])
  @@index([slug])
  @@index([sourceId])
  @@index([isActive])
  @@index([sortOrder])
  @@map("categories")
}

// ============================================================================
// PRODUCTS & PRICING
// ============================================================================

model Product {
  id              String                 @id @default(uuid()) @db.VarChar(36)
  sku             String                 @unique @db.VarChar(60)
  slug            String                 @unique @db.VarChar(255)
  title           String                 @db.VarChar(255)
  description     String?                @db.Text
  categoryId      Int
  brandId         Int?
  modelId         Int?
  retailPrice     Decimal                @db.Decimal(10, 2)
  salePrice       Decimal?               @db.Decimal(10, 2)
  minOrderQty     Int                    @default(1)
  stockQty        Int                    @default(0)
  weightGrams     Int                    @default(100)
  dimensionsJson  Json?                  // Format: {"length": 15, "width": 8, "height": 2}
  qualityGrade    String?                @db.VarChar(50) // e.g. "OEM Tested", "Original Pull", "A+"
  isActive        Boolean                @default(true)
  metaTitle       String?                @db.VarChar(255)
  metaDescription String?                @db.VarChar(500)
  sourceId        Int?                   @unique // Original WooCommerce Product ID
  sourceUrl       String?                @db.VarChar(500) // Original canonical permalink
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  deletedAt       DateTime?

  // Relationships
  category        Category               @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  brand           Brand?                 @relation(fields: [brandId], references: [id], onDelete: SetNull)
  model           DeviceModel?           @relation(fields: [modelId], references: [id], onDelete: SetNull)
  images          ProductImage[]
  compatibilities ProductCompatibility[]
  wholesaleTiers  ProductWholesaleTier[]
  attributes      ProductAttribute[]
  cartItems       CartItem[]
  orderItems      OrderItem[]
  reviews         Review[]

  @@index([sku])
  @@index([slug])
  @@index([sourceId])
  @@index([categoryId])
  @@index([brandId])
  @@index([modelId])
  @@index([isActive])
  @@index([stockQty])
  @@index([retailPrice])
  @@map("products")
}

model ProductImage {
  id        String   @id @default(uuid()) @db.VarChar(36)
  productId String   @db.VarChar(36)
  imageUrl  String   @db.VarChar(255)
  altText   String?  @db.VarChar(255)
  sortOrder Int      @default(0)
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([isPrimary])
  @@map("product_images")
}

model ProductCompatibility {
  id        String      @id @default(uuid()) @db.VarChar(36)
  productId String      @db.VarChar(36)
  modelId   Int
  notes     String?     @db.VarChar(255) // e.g. "Also fits Indian model CPH2359"

  product   Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  model     DeviceModel @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@unique([productId, modelId])
  @@index([productId])
  @@index([modelId])
  @@map("product_compatibilities")
}

model ProductWholesaleTier {
  id          String   @id @default(uuid()) @db.VarChar(36)
  productId   String   @db.VarChar(36)
  minQuantity Int      // e.g. 5, 10, 50
  tierPrice   Decimal  @db.Decimal(10, 2)

  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, minQuantity])
  @@index([productId])
  @@map("product_wholesale_tiers")
}

model ProductAttribute {
  id        String   @id @default(uuid()) @db.VarChar(36)
  productId String   @db.VarChar(36)
  name      String   @db.VarChar(80)  // e.g. "Color", "Pin Count", "Material", "Version"
  value     String   @db.VarChar(150) // e.g. "Midnight Black", "30-Pin", "Copper Flex"
  sortOrder Int      @default(0)

  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_attributes")
}

// ============================================================================
// CART
// ============================================================================

model Cart {
  id             String     @id @default(uuid()) @db.VarChar(36)
  userId         String?    @unique @db.VarChar(36)
  guestSessionId String?    @unique @db.VarChar(100)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  user           User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items          CartItem[]

  @@index([userId])
  @@index([guestSessionId])
  @@map("carts")
}

model CartItem {
  id        String   @id @default(uuid()) @db.VarChar(36)
  cartId    String   @db.VarChar(36)
  productId String   @db.VarChar(36)
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
  @@index([cartId])
  @@index([productId])
  @@map("cart_items")
}

// ============================================================================
// ORDERS & FULFILLMENT
// ============================================================================

model Order {
  id             String               @id @default(uuid()) @db.VarChar(36)
  orderNumber    String               @unique @db.VarChar(32) // e.g. "AT-2026-00001"
  userId         String               @db.VarChar(36)
  subtotal       Decimal              @db.Decimal(10, 2)
  discountAmount Decimal              @default(0.00) @db.Decimal(10, 2)
  shippingFee    Decimal              @default(0.00) @db.Decimal(10, 2)
  taxAmount      Decimal              @default(0.00) @db.Decimal(10, 2)
  totalAmount    Decimal              @db.Decimal(10, 2)
  paymentStatus  PaymentStatus        @default(PENDING)
  orderStatus    OrderStatus          @default(RECEIVED)
  customerNotes  String?              @db.Text
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  deletedAt      DateTime?

  // Relationships
  user           User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  address        OrderAddress?
  items          OrderItem[]
  statusHistory  OrderStatusHistory[]
  payments       Payment[]
  shipment       Shipment?

  @@index([orderNumber])
  @@index([userId])
  @@index([orderStatus])
  @@index([paymentStatus])
  @@index([createdAt])
  @@map("orders")
}

model OrderAddress {
  id           String  @id @default(uuid()) @db.VarChar(36)
  orderId      String  @unique @db.VarChar(36)
  name         String  @db.VarChar(100)
  phone        String  @db.VarChar(15)
  businessName String? @db.VarChar(150)
  gstin        String? @db.VarChar(15)
  addressLine1 String  @db.VarChar(255)
  addressLine2 String? @db.VarChar(255)
  landmark     String? @db.VarChar(150)
  city         String  @db.VarChar(80)
  state        String  @db.VarChar(80)
  pincode      String  @db.VarChar(10)

  order        Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_addresses")
}

model OrderItem {
  id           String   @id @default(uuid()) @db.VarChar(36)
  orderId      String   @db.VarChar(36)
  productId    String?  @db.VarChar(36)
  sku          String   @db.VarChar(60)
  productTitle String   @db.VarChar(255)
  unitPrice    Decimal  @db.Decimal(10, 2)
  quantity     Int
  totalPrice   Decimal  @db.Decimal(10, 2)
  tierApplied  String?  @db.VarChar(100) // Snapshot: e.g. "Wholesale Tier: 10+ pcs @ 180.00"

  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product      Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model OrderStatusHistory {
  id              String       @id @default(uuid()) @db.VarChar(36)
  orderId         String       @db.VarChar(36)
  fromStatus      OrderStatus?
  toStatus        OrderStatus
  comment         String?      @db.VarChar(255)
  changedByUserId String?      @db.VarChar(36)
  createdAt       DateTime     @default(now())

  order           Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedBy       User?        @relation(fields: [changedByUserId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@map("order_status_history")
}

// ============================================================================
// PAYMENTS
// ============================================================================

model Payment {
  id                 String         @id @default(uuid()) @db.VarChar(36)
  orderId            String         @db.VarChar(36)
  gateway            PaymentGateway @default(RAZORPAY)
  gatewayOrderId     String?        @db.VarChar(100)
  gatewayPaymentId   String?        @db.VarChar(100)
  amount             Decimal        @db.Decimal(10, 2)
  currency           String         @default("INR") @db.VarChar(5)
  status             PaymentStatus  @default(PENDING)
  signature          String?        @db.VarChar(255)
  failureReason      String?        @db.Text
  rawWebhookPayload  Json?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  order              Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([gatewayOrderId])
  @@index([gatewayPaymentId])
  @@index([status])
  @@map("payments")
}

// ============================================================================
// DELHIVERY & LOGISTICS
// ============================================================================

model Shipment {
  id             String                  @id @default(uuid()) @db.VarChar(36)
  orderId        String                  @unique @db.VarChar(36)
  courier        String                  @default("Delhivery") @db.VarChar(50)
  awbCode        String?                 @unique @db.VarChar(64)
  status         ShipmentStatus          @default(PENDING)
  labelPdfUrl    String?                 @db.VarChar(255)
  routingCode    String?                 @db.VarChar(50)
  weightGrams    Int                     @default(150)
  lengthCm       Decimal?                @db.Decimal(6, 2)
  widthCm        Decimal?                @db.Decimal(6, 2)
  heightCm       Decimal?                @db.Decimal(6, 2)
  pickupLocation String                  @default("Primary Warehouse") @db.VarChar(100)
  dispatchedAt   DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  order          Order                   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  trackingEvents ShipmentTrackingEvent[]

  @@index([awbCode])
  @@index([status])
  @@index([orderId])
  @@map("shipments")
}

model ShipmentTrackingEvent {
  id             String    @id @default(uuid()) @db.VarChar(36)
  shipmentId     String    @db.VarChar(36)
  milestone      String    @db.VarChar(100) // e.g. "PICKED UP", "IN TRANSIT", "OUT FOR DELIVERY"
  location       String?   @db.VarChar(100) // e.g. "Delhi Hub", "Mumbai Sort Facility"
  eventTimestamp DateTime
  rawEventData   Json?
  createdAt      DateTime  @default(now())

  shipment       Shipment  @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId])
  @@index([eventTimestamp])
  @@map("shipment_tracking_events")
}

// ============================================================================
// PRODUCT REVIEWS
// ============================================================================

model Review {
  id        String       @id @default(uuid()) @db.VarChar(36)
  productId String       @db.VarChar(36)
  userId    String       @db.VarChar(36)
  rating    Int          // Validated 1 to 5
  title     String?      @db.VarChar(150)
  comment   String       @db.Text
  status    ReviewStatus @default(PENDING)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, userId]) // One review per user per product
  @@index([productId])
  @@index([status])
  @@map("reviews")
}

// ============================================================================
// STORE SETTINGS & CMS
// ============================================================================

model StoreSetting {
  id          Int      @id @default(autoincrement())
  group       String   @db.VarChar(50) // "wholesale", "tax", "shipping", "general", "seo", "contact"
  key         String   @unique @db.VarChar(80)
  value       String   @db.Text
  description String?  @db.VarChar(255)
  isPublic    Boolean  @default(false)
  updatedAt   DateTime @updatedAt

  @@index([group])
  @@index([key])
  @@map("store_settings")
}

model Banner {
  id        Int      @id @default(autoincrement())
  title     String   @db.VarChar(150)
  imageUrl  String   @db.VarChar(255)
  linkUrl   String?  @db.VarChar(255)
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([isActive])
  @@index([sortOrder])
  @@map("banners")
}

model CmsPage {
  id              Int      @id @default(autoincrement())
  title           String   @db.VarChar(150)
  slug            String   @unique @db.VarChar(150)
  contentHtml     String   @db.LongText
  metaTitle       String?  @db.VarChar(255)
  metaDescription String?  @db.VarChar(500)
  isPublished     Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([slug])
  @@index([isPublished])
  @@map("cms_pages")
}

model BlogPost {
  id              Int       @id @default(autoincrement())
  title           String    @db.VarChar(255)
  slug            String    @unique @db.VarChar(255)
  summary         String?   @db.Text
  contentHtml     String    @db.LongText
  featuredImage   String?   @db.VarChar(255)
  authorId        String    @db.VarChar(36)
  isPublished     Boolean   @default(false)
  publishedAt     DateTime?
  metaTitle       String?   @db.VarChar(255)
  metaDescription String?   @db.VarChar(500)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  author          User      @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([slug])
  @@index([isPublished])
  @@index([authorId])
  @@map("blog_posts")
}

// ============================================================================
// AUDIT & ADMINISTRATIVE LOGGING
// ============================================================================

model AuditLog {
  id          String   @id @default(uuid()) @db.VarChar(36)
  actorId     String?  @db.VarChar(36)
  actorPhone  String?  @db.VarChar(15)
  actorRole   String?  @db.VarChar(50)
  action      String   @db.VarChar(100) // e.g. "UPDATE_PRODUCT_PRICE", "GENERATE_DELHIVERY_AWB"
  entity      String   @db.VarChar(80)  // e.g. "Product", "Order", "StoreSetting"
  entityId    String   @db.VarChar(64)
  detailsJson Json?
  ipAddress   String?  @db.VarChar(45)
  userAgent   String?  @db.VarChar(255)
  createdAt   DateTime @default(now())

  actor       User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([actorId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}
