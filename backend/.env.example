# ==============================================================================
# ABHAY TECHNICALS — BACKEND ENVIRONMENT CONFIGURATION (TEMPLATE)
# ==============================================================================
# Copy this file to .env and supply isolated environment values.
# NEVER commit production credentials to version control.
# ==============================================================================

# Server Environment
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# MySQL Database (Isolated local development database)
DATABASE_URL=mysql://db_user:db_password@localhost:3306/abhay_technicals_dev

# JWT Authentication Secrets
JWT_ACCESS_SECRET=your_jwt_access_secret_at_least_32_chars_long
JWT_REFRESH_SECRET=your_jwt_refresh_secret_at_least_32_chars_long
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# WhatsApp Cloud API (Meta) - Placeholders for Phase 8
WHATSAPP_API_URL=https://graph.facebook.com/v19.0
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_meta_whatsapp_access_token
WHATSAPP_BUSINESS_ACCOUNT_ID=your_meta_business_account_id

# Payment Gateway - Razorpay - Placeholders for Phase 9
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Payment Gateway - Cashfree (Alternative) - Placeholders for Phase 9
CASHFREE_APP_ID=your_cashfree_app_id
CASHFREE_SECRET_KEY=your_cashfree_secret_key
CASHFREE_API_VERSION=2023-08-01

# Logistics - Delhivery - Placeholders for Phase 10
DELHIVERY_API_KEY=your_delhivery_api_token
DELHIVERY_CLIENT_NAME=your_delhivery_client_name
DELHIVERY_BASE_URL=https://track.delhivery.com

# Firebase Cloud Messaging (FCM) - Placeholders for Phase 12
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_firebase_client_email
FIREBASE_PRIVATE_KEY=your_firebase_private_key
